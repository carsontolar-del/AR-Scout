# All keys are free. Deezer, MusicBrainz and Wikipedia need no key at all.

# https://www.last.fm/api/account/create
LASTFM_API_KEY=

# https://console.cloud.google.com -> enable "YouTube Data API v3" -> Credentials -> API key
YOUTUBE_API_KEY=

# https://developer.spotify.com/dashboard (optional: used for IDs, genres, release history;
# Dev Mode apps no longer receive follower/popularity numbers)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Contact for MusicBrainz/Wikipedia User-Agent etiquette
CONTACT_EMAIL=

# Where the SQLite database lives (default: ./data/ar_scout.db)
AR_SCOUT_DB=
