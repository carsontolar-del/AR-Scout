# All keys are free. Deezer, MusicBrainz and Wikipedia need no key at all.

# https://www.last.fm/api/account/create
LASTFM_API_KEY=

# https://console.cloud.google.com -> enable "YouTube Data API v3" -> Credentials -> API key
YOUTUBE_API_KEY=

# https://developer.spotify.com/dashboard (optional: used for IDs, genres, release history;
# Dev Mode apps no longer receive follower/popularity numbers)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Instagram follower counts via Business Discovery (optional, free). Only public professional (Business or
# Creator) accounts can be read. Setup:
#  1. Make your own Instagram account professional (Settings > Account type) and link it to a Facebook Page.
#  2. developers.facebook.com > My Apps > Create app (type "Business"), add the "Instagram" product
#     ("API setup with Facebook login").
#  3. Graph API Explorer: pick the app, add permissions instagram_basic, instagram_manage_insights,
#     pages_show_list, pages_read_engagement, then Generate Access Token.
#  4. Exchange it for a long-lived token (~60 days): Access Token Debugger > "Extend Access Token".
#  5. Your account ID: in the Explorer run  me/accounts?fields=instagram_business_account
#  6. Check it: .venv/bin/ar-scout instagram-test
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ID=
# Optional: pin a Graph API version like v23.0 (blank = your app's default)
INSTAGRAM_GRAPH_VERSION=

# Sign-in for a hosted dashboard. Leave both blank on your own laptop: no login. Set them on the host.
#   Team password: colleagues can search, discover, watch, move the pipeline, take notes, archive.
#   Admin password: also bulk refresh, linking, changing YouTube/Instagram accounts, deleting artists.
# Use long passphrases (e.g. four random words). AR_SCOUT_SECRET signs sign-in cookies; set any long random
# string on the host (or leave blank to have one generated next to the database).
AR_SCOUT_TEAM_PASSWORD=
AR_SCOUT_ADMIN_PASSWORD=
AR_SCOUT_SECRET=

# Daily snapshot inside the dashboard, for a host (leave blank on a Mac that runs install-daily-snapshot.sh).
AR_SCOUT_DAILY_AT=
AR_SCOUT_TZ=America/Denver

# Contact for MusicBrainz/Wikipedia User-Agent etiquette
CONTACT_EMAIL=

# Where the SQLite database lives (default: ./data/ar_scout.db)
AR_SCOUT_DB=
# Where daily backups go (default: ./data/backups). An iCloud Drive folder keeps a copy off this Mac, e.g.
# ~/Library/Mobile Documents/com~apple~CloudDocs/AR Scout Backups
AR_SCOUT_BACKUP_DIR=
